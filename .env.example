# EV Challenge 2026 - GoodWe | Sprint 04
# Copie este arquivo para .env e preencha os valores necessários.
# NUNCA coloque sua API key no Git. O arquivo .env deve estar no .gitignore.

# ============================================================
# EMBEDDINGS — OLLAMA LOCAL
# ============================================================

# Servidor Ollama local usado exclusivamente para embeddings.
OLLAMA_LOCAL_HOST=http://localhost:11434

# Modelo de embedding.
EMBEDDING_MODEL=nomic-embed-text


# ============================================================
# LLMs — OLLAMA CLOUD / API
# ============================================================

# Endpoint da API usado pelos modelos de linguagem.
OLLAMA_CLOUD_HOST=https://ollama.com

# Sua chave da API do Ollama Cloud.
OLLAMA_API_KEY=SUA_CHAVE_OLLAMA_AQUI

# Modelos usados pelo projeto/comparação.
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_MODEL_2=nemotron-3-nano:30b


# ============================================================
# PARÂMETROS DO LLM
# ============================================================

TEMPERATURE=0
TOP_P=0.95
MAX_TOKENS=512


# ============================================================
# RECUPERAÇÃO RAG
# ============================================================

TOP_K=3
MIN_RELEVANCE=0.20


# ============================================================
# CHUNKING
# ============================================================

CHUNK_SIZE=800
CHUNK_OVERLAP=100


# ============================================================
# PROMPT RAG
# ============================================================

RAG_PROMPT_VERSION=v2.0


# ============================================================
# INTERFACE GRADIO
# ============================================================

# false = somente local
# true  = gera URL pública do Gradio
GRADIO_SHARE=false
